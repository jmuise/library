root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# Continuation lines in shell-heavy RUN steps are aligned by hand.
[{Dockerfile,*.Dockerfile}]
indent_size = unset
