{
  "name": "library",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/library",
  "remoteUser": "vscode",

  // Exact pins: a floating major would let a rebuild pull different tooling.
  // docker-in-docker (not the host socket) so the container can build and run images and
  // reach their published ports on its own localhost; it ships buildx; multi-arch
  // builds need QEMU binfmt (see CLAUDE.md). The feature requests a privileged container itself.
  // gh is pinned too (feature default is "latest"); options do not affect devcontainer-lock.json.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.2": { "version": "2.103.3" }
  },

  // The coming-soon page (Caddy) listens on 8080 in the container image; forward it when run.
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "library (caddy)", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "timonwong.shellcheck",
        "exiasr.hadolint",
        "github.vscode-github-actions"
      ]
    }
  }
}
